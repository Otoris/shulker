{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "esnext"],
    "allowJs": true,
    "esModuleInterop": true,
    "removeComments": true,
    "strict": true,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "rootDir": "./src",
    "outDir": "build/",
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node", "jest"],
    "skipLibCheck": true
  },
  "include": ["./src/**/*", "./typings/**/*"],
  "exclude": ["node_modules"]
}
